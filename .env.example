# ── Local Outlook COM (推荐，无需 OAuth) ─────────────────────────────────────
# 使用本地已登录的 Outlook 客户端，不需要任何认证配置
TASK_PILOT_USE_OUTLOOK_COM=true
TASK_PILOT_OUTLOOK_FOLDER=收件箱
TASK_PILOT_OUTLOOK_CALENDAR_NAME=          # 留空=使用默认日历

# ── Microsoft Graph (备选，需 OAuth) ─────────────────────────────────────────
# 如果不想用 COM 方式，可以配置 Graph API
TASK_PILOT_MS_GRAPH_TOKEN=
TASK_PILOT_MAILBOX=me
TASK_PILOT_CALENDAR_ID=calendar

# ── DingTalk ─────────────────────────────────────────────────────────────────
# Create an internal app at open.dingtalk.com
TASK_PILOT_DINGTALK_APP_KEY=
TASK_PILOT_DINGTALK_APP_SECRET=

# ── AI / LLM (邮件内容分析) ───────────────────────────────────────────────────
# 支持 minimax (默认) 和 anthropic 两种 provider
TASK_PILOT_LLM_API_KEY=
TASK_PILOT_LLM_BASE_URL=https://api.minimax.chat/v1
TASK_PILOT_LLM_MODEL=MiniMax-M2.7
TASK_PILOT_LLM_PROVIDER=minimax

# ── Mistral OCR (PDF/图片文字识别) ────────────────────────────────────────────
# 用于识别 PDF 扫描件和图片附件中的文字
TASK_PILOT_MISTRAL_API_KEY=
TASK_PILOT_MISTRAL_OCR_URL=https://api.mistral.ai/v1/ocr

# ── Polling ──────────────────────────────────────────────────────────────────
# How often to check for new messages (seconds)
TASK_PILOT_POLL_INTERVAL_SECONDS=300
