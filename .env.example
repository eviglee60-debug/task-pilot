# ── Microsoft Graph (Email + Calendar) ────────────────────────────────────────
# OAuth access token with Mail.Read + Calendars.ReadWrite scopes
# Generate via Azure AD app registration
TASK_PILOT_MS_GRAPH_TOKEN=
TASK_PILOT_MAILBOX=me
TASK_PILOT_CALENDAR_ID=calendar

# ── DingTalk ─────────────────────────────────────────────────────────────────
# Create an internal app at open.dingtalk.com
TASK_PILOT_DINGTALK_APP_KEY=
TASK_PILOT_DINGTALK_APP_SECRET=

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Anthropic API key for Claude
TASK_PILOT_LLM_API_KEY=
TASK_PILOT_LLM_BASE_URL=https://api.anthropic.com
TASK_PILOT_LLM_MODEL=claude-sonnet-4-20250514

# ── Polling ──────────────────────────────────────────────────────────────────
# How often to check for new messages (seconds)
TASK_PILOT_POLL_INTERVAL_SECONDS=300
